{
  "version": 1,
  "include": [
    "LICENSE.txt",
    "README.md"
  ],
  "targets": {
    "win-x64": {
      "executable": "dotnet",
      "arguments": [
        "publish",
        "hashashin.FxCommands.csproj",
        "-c",
        "Release",
        "-r",
        "win-x64",
        "--self-contained",
        "false",
        "-p:UseAppHost=false",
        "-o",
        "bin/publish/win-x64"
      ],
      "output": "bin/publish/win-x64"
    }
  }
}
